<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org is used. Machine-level feeds are cleared so builds are reproducible
     and no package can be resolved from an unexpected source (supply-chain hygiene). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
