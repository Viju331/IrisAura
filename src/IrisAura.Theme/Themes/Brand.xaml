<!--
  IrisAura brand tokens (BLUEPRINT §0.4). The single source of brand colours for every WPF app.

  Naming:
    Aura.<Token>        SolidColorBrush (use this in views)
    Aura.<Token>.Color  Color (use for animations and gradient stops)

  Merge in App.xaml:
    <ResourceDictionary Source="pack://application:,,,/IrisAura.Theme;component/Themes/Brand.xaml" />

  Do not hard-code hex values in views. Aura.Error is for failure states only, never for branding.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

  <!-- Colours -->
  <Color x:Key="Aura.Void.Color">#FF000000</Color>
  <Color x:Key="Aura.Surface.Color">#FF0B0D1A</Color>
  <Color x:Key="Aura.Frost.Color">#FFE2E6F4</Color>
  <Color x:Key="Aura.Mist.Color">#FFA8C4F0</Color>
  <Color x:Key="Aura.Cyan.Color">#FF22C3F2</Color>
  <Color x:Key="Aura.Blue.Color">#FF4A92F2</Color>
  <Color x:Key="Aura.Indigo.Color">#FF1A30A8</Color>
  <Color x:Key="Aura.Violet.Color">#FF8A3FF2</Color>
  <Color x:Key="Aura.Error.Color">#FFFF4D5E</Color>

  <!-- Brushes (frozen: shared, immutable, cheaper to render) -->
  <SolidColorBrush x:Key="Aura.Void" Color="{StaticResource Aura.Void.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Surface" Color="{StaticResource Aura.Surface.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Frost" Color="{StaticResource Aura.Frost.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Mist" Color="{StaticResource Aura.Mist.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Cyan" Color="{StaticResource Aura.Cyan.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Blue" Color="{StaticResource Aura.Blue.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Indigo" Color="{StaticResource Aura.Indigo.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Violet" Color="{StaticResource Aura.Violet.Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Aura.Error" Color="{StaticResource Aura.Error.Color}" po:Freeze="True" />

  <!-- Signature "Aura ring" gradient: Cyan → Blue → Violet at 135° (top-left to bottom-right).
       Use sparingly: Face scan ring, settings header line, primary-button hover glow. Never body text. -->
  <LinearGradientBrush x:Key="Aura.Ring" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
    <GradientStop Offset="0.0" Color="{StaticResource Aura.Cyan.Color}" />
    <GradientStop Offset="0.5" Color="{StaticResource Aura.Blue.Color}" />
    <GradientStop Offset="1.0" Color="{StaticResource Aura.Violet.Color}" />
  </LinearGradientBrush>

  <!-- Typography (BLUEPRINT §0.5): Segoe UI Variable on Windows 11, Segoe UI fallback. -->
  <FontFamily x:Key="Aura.Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Aura.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

</ResourceDictionary>
