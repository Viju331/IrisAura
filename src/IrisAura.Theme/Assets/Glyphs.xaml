<!--
  IrisAura glyphs (BLUEPRINT §0.5): an original vector "person in corner brackets" mark that echoes
  the logo. It is a generic face-recognition symbol: no smiley face, no Apple-style face lines.

  All geometries use a 24 × 24 design grid and are meant to be STROKED, not filled:
    Stroke = Aura.Frost (or Aura.Cyan for success), StrokeThickness ≈ 1.6 at 24 px,
    StrokeStartLineCap/StrokeEndLineCap = Round, StrokeLineJoin = Round.
  Scale with a Viewbox or a ScaleTransform.

  Keep in sync with assets/brand/source/*.svg (same path data).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

  <!-- Four rounded corner brackets (open paths). The scan animation pulses these. -->
  <PathGeometry x:Key="Aura.Glyph.FaceBrackets" po:Freeze="True"
                Figures="M 2,8 V 5 A 3,3 0 0 1 5,2 H 8
                         M 16,2 H 19 A 3,3 0 0 1 22,5 V 8
                         M 22,16 V 19 A 3,3 0 0 1 19,22 H 16
                         M 8,22 H 5 A 3,3 0 0 1 2,19 V 16" />

  <!-- Head-and-shoulders outline inside the brackets. Cross-fades into the checkmark on success. -->
  <PathGeometry x:Key="Aura.Glyph.FacePerson" po:Freeze="True"
                Figures="M 12,6.5 A 3,3 0 1 1 12,12.5 A 3,3 0 1 1 12,6.5 Z
                         M 6.5,19 C 6.5,15.8 9,14 12,14 C 15,14 17.5,15.8 17.5,19" />

  <!-- Success checkmark, drawn in Aura.Cyan. -->
  <PathGeometry x:Key="Aura.Glyph.Check" po:Freeze="True"
                Figures="M 7,12.5 L 10.5,16 L 17,8.5" />

  <!-- Media transport glyphs: generic play/pause/skip shapes, FILLED (not stroked). Original
       simple geometry; no system or third-party icon font. -->
  <PathGeometry x:Key="Aura.Glyph.Play" po:Freeze="True"
                Figures="M 8,5 L 19,12 L 8,19 Z" />
  <PathGeometry x:Key="Aura.Glyph.Pause" po:Freeze="True"
                Figures="M 7,5 H 10.5 V 19 H 7 Z M 13.5,5 H 17 V 19 H 13.5 Z" />
  <PathGeometry x:Key="Aura.Glyph.Previous" po:Freeze="True"
                Figures="M 5,5 H 7.5 V 19 H 5 Z M 19,5 L 9,12 L 19,19 Z" />
  <PathGeometry x:Key="Aura.Glyph.Next" po:Freeze="True"
                Figures="M 16.5,5 H 19 V 19 H 16.5 Z M 5,5 L 15,12 L 5,19 Z" />

  <!-- Recommended stroke thickness at the 24-unit design size. -->
  <system:Double x:Key="Aura.Glyph.StrokeThickness">1.6</system:Double>

</ResourceDictionary>
