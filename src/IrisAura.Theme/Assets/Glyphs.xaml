<!--
  IrisAura glyphs (BLUEPRINT §0.5): an original vector "person in corner brackets" mark that echoes
  the logo. It is a generic face-recognition symbol: no smiley face, no Apple-style face lines.

  All geometries use a 24 × 24 design grid and are meant to be STROKED, not filled:
    Stroke = Aura.Frost (or Aura.Cyan for success), StrokeThickness ≈ 1.6 at 24 px,
    StrokeStartLineCap/StrokeEndLineCap = Round, StrokeLineJoin = Round.
  Scale with a Viewbox or a ScaleTransform.

  Keep in sync with assets/brand/source/*.svg (same path data).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

  <!-- Four rounded corner brackets (open paths). The scan animation pulses these. -->
  <PathGeometry x:Key="Aura.Glyph.FaceBrackets" po:Freeze="True"
                Figures="M 2,8 V 5 A 3,3 0 0 1 5,2 H 8
                         M 16,2 H 19 A 3,3 0 0 1 22,5 V 8
                         M 22,16 V 19 A 3,3 0 0 1 19,22 H 16
                         M 8,22 H 5 A 3,3 0 0 1 2,19 V 16" />

  <!-- Head-and-shoulders outline inside the brackets. Cross-fades into the checkmark on success. -->
  <PathGeometry x:Key="Aura.Glyph.FacePerson" po:Freeze="True"
                Figures="M 12,6.5 A 3,3 0 1 1 12,12.5 A 3,3 0 1 1 12,6.5 Z
                         M 6.5,19 C 6.5,15.8 9,14 12,14 C 15,14 17.5,15.8 17.5,19" />

  <!-- Success checkmark, drawn in Aura.Cyan. -->
  <PathGeometry x:Key="Aura.Glyph.Check" po:Freeze="True"
                Figures="M 7,12.5 L 10.5,16 L 17,8.5" />

  <!-- Media transport glyphs: generic play/pause/skip shapes, FILLED (not stroked). Original
       simple geometry; no system or third-party icon font. -->
  <PathGeometry x:Key="Aura.Glyph.Play" po:Freeze="True"
                Figures="M 8,5 L 19,12 L 8,19 Z" />
  <PathGeometry x:Key="Aura.Glyph.Pause" po:Freeze="True"
                Figures="M 7,5 H 10.5 V 19 H 7 Z M 13.5,5 H 17 V 19 H 13.5 Z" />
  <PathGeometry x:Key="Aura.Glyph.Previous" po:Freeze="True"
                Figures="M 5,5 H 7.5 V 19 H 5 Z M 19,5 L 9,12 L 19,19 Z" />
  <PathGeometry x:Key="Aura.Glyph.Next" po:Freeze="True"
                Figures="M 16.5,5 H 19 V 19 H 16.5 Z M 5,5 L 15,12 L 5,19 Z" />

  <!-- System activity glyphs (Phase 4), FILLED, original simple geometry on the 24-unit grid. Holes use the
       default even-odd fill rule of PathGeometry. No system icon font, no Apple symbols, no Bluetooth logo
       (trademark): Bluetooth devices use the glyph of their device class. -->
  <PathGeometry x:Key="Aura.Glyph.Volume" po:Freeze="True"
                Figures="M 3,9 H 7 L 12,4.5 V 19.5 L 7,15 H 3 Z
                         M 14.5,8 A 4.2,4.2 0 0 1 14.5,16 A 6,6 0 0 0 14.5,8 Z
                         M 17,5.5 A 6.6,6.6 0 0 1 17,18.5 A 8.5,8.5 0 0 0 17,5.5 Z" />
  <PathGeometry x:Key="Aura.Glyph.VolumeMute" po:Freeze="True"
                Figures="M 3,9 H 7 L 12,4.5 V 19.5 L 7,15 H 3 Z
                         M 15,9.7 L 16.2,8.5 L 18.5,10.8 L 20.8,8.5 L 22,9.7 L 19.7,12 L 22,14.3 L 20.8,15.5
                           L 18.5,13.2 L 16.2,15.5 L 15,14.3 L 17.3,12 Z" />
  <PathGeometry x:Key="Aura.Glyph.Brightness" po:Freeze="True"
                Figures="M 12,8 A 4,4 0 1 1 12,16 A 4,4 0 1 1 12,8 Z
                         M 11,3.5 H 13 V 6.5 H 11 Z M 11,17.5 H 13 V 20.5 H 11 Z
                         M 3.5,11 H 6.5 V 13 H 3.5 Z M 17.5,11 H 20.5 V 13 H 17.5 Z
                         M 16.24,9.17 L 18.36,7.05 L 16.95,5.63 L 14.83,7.75 Z
                         M 9.17,7.75 L 7.05,5.63 L 5.63,7.05 L 7.75,9.17 Z
                         M 16.24,14.83 L 18.36,16.95 L 16.95,18.36 L 14.83,16.24 Z
                         M 9.17,16.24 L 7.05,18.36 L 5.63,16.95 L 7.75,14.83 Z" />
  <PathGeometry x:Key="Aura.Glyph.Bolt" po:Freeze="True"
                Figures="M 13.5,2 L 5,13.5 H 11 L 10,22 L 19,10 H 13 Z" />
  <PathGeometry x:Key="Aura.Glyph.BatteryLow" po:Freeze="True"
                Figures="M 3,7 H 19 V 17 H 3 Z M 4.8,8.8 V 15.2 H 17.2 V 8.8 Z
                         M 20,10 H 22 V 14 H 20 Z M 6.3,10.3 H 9 V 13.7 H 6.3 Z" />
  <PathGeometry x:Key="Aura.Glyph.Headphones" po:Freeze="True"
                Figures="M 4,14 V 12 A 8,8 0 0 1 20,12 V 14 H 18 V 12 A 6,6 0 0 0 6,12 V 14 Z
                         M 3,14 H 8 V 21 H 5 A 2,2 0 0 1 3,19 Z
                         M 16,14 H 21 V 19 A 2,2 0 0 1 19,21 H 16 Z" />
  <PathGeometry x:Key="Aura.Glyph.Mouse" po:Freeze="True"
                Figures="M 12,3 A 6,6 0 0 1 18,9 V 15 A 6,6 0 0 1 6,15 V 9 A 6,6 0 0 1 12,3 Z
                         M 11.2,6 V 10 H 12.8 V 6 Z" />
  <PathGeometry x:Key="Aura.Glyph.Keyboard" po:Freeze="True"
                Figures="M 2,6 H 22 V 18 H 2 Z
                         M 4,8 H 6 V 10 H 4 Z M 8,8 H 10 V 10 H 8 Z M 12,8 H 14 V 10 H 12 Z M 16,8 H 20 V 10 H 16 Z
                         M 4,12 H 8 V 14 H 4 Z M 10,12 H 14 V 14 H 10 Z M 16,12 H 20 V 14 H 16 Z
                         M 7,15.2 H 17 V 16.6 H 7 Z" />
  <PathGeometry x:Key="Aura.Glyph.Phone" po:Freeze="True"
                Figures="M 7,2 H 17 A 2,2 0 0 1 19,4 V 20 A 2,2 0 0 1 17,22 H 7 A 2,2 0 0 1 5,20 V 4 A 2,2 0 0 1 7,2 Z
                         M 7,5 V 18 H 17 V 5 Z M 10.5,19.2 H 13.5 V 20.6 H 10.5 Z" />
  <PathGeometry x:Key="Aura.Glyph.Device" po:Freeze="True"
                Figures="M 5,3 H 19 A 2,2 0 0 1 21,5 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 5 A 2,2 0 0 1 5,3 Z
                         M 12,8 A 4,4 0 1 0 12,16 A 4,4 0 1 0 12,8 Z" />
  <PathGeometry x:Key="Aura.Glyph.Timer" po:Freeze="True"
                Figures="M 12,4 A 8.5,8.5 0 1 1 12,21 A 8.5,8.5 0 1 1 12,4 Z
                         M 12,6 A 6.5,6.5 0 1 0 12,19 A 6.5,6.5 0 1 0 12,6 Z
                         M 10,1.5 H 14 V 3.2 H 10 Z M 11.2,8.5 H 12.8 V 13.5 H 11.2 Z" />
  <PathGeometry x:Key="Aura.Glyph.Download" po:Freeze="True"
                Figures="M 11,3 H 13 V 13.2 L 16.6,9.6 L 18,11 L 12,17 L 6,11 L 7.4,9.6 L 11,13.2 Z
                         M 4,19 H 20 V 21 H 4 Z" />
  <PathGeometry x:Key="Aura.Glyph.Mic" po:Freeze="True"
                Figures="M 12,2 A 3.5,3.5 0 0 1 15.5,5.5 V 11.5 A 3.5,3.5 0 0 1 8.5,11.5 V 5.5 A 3.5,3.5 0 0 1 12,2 Z
                         M 5.5,11 H 7.3 A 4.7,4.7 0 0 0 16.7,11 H 18.5 A 6.5,6.5 0 0 1 12.9,17.4 V 20 H 15.5 V 22
                           H 8.5 V 20 H 11.1 V 17.4 A 6.5,6.5 0 0 1 5.5,11 Z" />
  <PathGeometry x:Key="Aura.Glyph.Camera" po:Freeze="True"
                Figures="M 3,7 H 16 A 1,1 0 0 1 17,8 V 10.5 L 21,8 V 16 L 17,13.5 V 16 A 1,1 0 0 1 16,17 H 3
                           A 1,1 0 0 1 2,16 V 8 A 1,1 0 0 1 3,7 Z" />
  <PathGeometry x:Key="Aura.Glyph.Call" po:Freeze="True"
                Figures="M 6.6,3 L 9.6,6 L 8,8.6 C 9.2,11.2 12.8,14.8 15.4,16 L 18,14.4 L 21,17.4 L 19,20.4
                           C 11,21 3,13 3.6,5 Z" />

  <!-- Recommended stroke thickness at the 24-unit design size. -->
  <system:Double x:Key="Aura.Glyph.StrokeThickness">1.6</system:Double>

</ResourceDictionary>
