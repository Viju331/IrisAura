<!-- Phase 0A placeholder: proves the shared theme and glyphs load at runtime.
     Replaced by the Island shell (Shell/IslandWindow) in Phase 1. -->
<Window x:Class="IrisAura.Island.SkeletonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IrisAura Island"
        Width="440" Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Aura.Surface}"
        FontFamily="{StaticResource Aura.Font.UI}">
  <StackPanel Margin="24" Orientation="Horizontal" VerticalAlignment="Center">
    <Viewbox Width="56" Height="56" Margin="0,0,20,0">
      <Canvas Width="24" Height="24">
        <Path Data="{StaticResource Aura.Glyph.FaceBrackets}" Stroke="{StaticResource Aura.Ring}"
              StrokeThickness="{StaticResource Aura.Glyph.StrokeThickness}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <Path Data="{StaticResource Aura.Glyph.FacePerson}" Stroke="{StaticResource Aura.Frost}"
              StrokeThickness="{StaticResource Aura.Glyph.StrokeThickness}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Canvas>
    </Viewbox>
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="IrisAura Island" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource Aura.Frost}" />
      <TextBlock Text="Phase 0A skeleton. The Island shell arrives in Phase 1." FontSize="12"
                 Margin="0,4,0,0" Foreground="{StaticResource Aura.Mist}" />
    </StackPanel>
  </StackPanel>
</Window>
