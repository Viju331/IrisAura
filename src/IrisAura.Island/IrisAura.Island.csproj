<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone IrisAura Island (Release 1). May reference only IrisAura.Contracts and
       IrisAura.Theme, never IrisAura.Face.* (BLUEPRINT §6; enforced by ArchitectureTests). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>IrisAura.Island</AssemblyName>
    <RootNamespace>IrisAura.Island</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Required by source-generated [LibraryImport] Win32 interop (Interop/NativeMethods.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Development releases (scripts/build-release.ps1 -Development) also trust the development update key. -->
    <DefineConstants Condition="'$(TrustDevelopmentKeys)' == 'true'">$(DefineConstants);IRISAURA_DEV_TRUST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provider contracts (ActivitySpec, IActivityProvider, …) from IrisAura.Island.Providers. -->
    <Using Include="IrisAura.Island.Activities" />
    <InternalsVisibleTo Include="IrisAura.Island.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging to %LocalAppData%\IrisAura\logs (BLUEPRINT §4). Approved; versions in Directory.Packages.props. -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IrisAura.Contracts\IrisAura.Contracts.csproj" />
    <ProjectReference Include="..\IrisAura.Theme\IrisAura.Theme.csproj" />
    <ProjectReference Include="..\IrisAura.Island.Providers\IrisAura.Island.Providers.csproj" />
  </ItemGroup>
</Project>
