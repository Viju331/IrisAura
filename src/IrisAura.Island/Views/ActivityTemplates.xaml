<!--
  Activity templates for the Island (BLUEPRINT §8.2, §8.6). Keys are "<PresentationMode>.<ViewModelType>".
  Phase 1 renders the fake activities; Phase 2+ adds templates for engine activities.
  Brand colours come only from IrisAura.Theme (Brand.xaml); no hex values here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:IrisAura.Island.Views.Controls"
                    xmlns:views="clr-namespace:IrisAura.Island.Views">

  <!-- Round icon button; Tag carries the glyph geometry. -->
  <Style x:Key="IslandIconButton" TargetType="Button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="18" Background="{TemplateBinding Background}"
                  BorderThickness="1.5" BorderBrush="Transparent">
            <Viewbox Width="18" Height="18">
              <Path Width="24" Height="24" Stretch="None" Fill="{TemplateBinding Foreground}"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Surface}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Indigo}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Aura.Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small pill-shaped text button. -->
  <Style x:Key="IslandTextButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
    <Setter Property="Background" Value="{StaticResource Aura.Surface}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="14" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1.5" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Indigo}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Blue}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Aura.Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin linear progress bar. -->
  <Style x:Key="IslandProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="2" Background="{StaticResource Aura.Surface}" />
            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource Aura.Frost}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Aura.Mist}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ===== Media ===== -->

  <DataTemplate x:Key="Compact.FakeMediaActivity">
    <Grid>
      <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" Margin="9,0,0,0"
              Background="{StaticResource Aura.Ring}" />
      <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{StaticResource Aura.Blue}"
                             Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Expanded.FakeMediaActivity">
    <Grid Margin="20,18,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource Aura.Ring}" />
        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,2,0,0"
                     Foreground="{StaticResource Aura.Mist}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock Text="{Binding AppName}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
          <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{StaticResource Aura.Blue}"
                                 Height="14" HorizontalAlignment="Right" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="38" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" Style="{StaticResource Caption}"
                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Style="{StaticResource IslandProgressBar}" Value="{Binding Progress, Mode=OneWay}"
                     VerticalAlignment="Center" Margin="4,0" AutomationProperties.Name="Playback position" />
        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Style="{StaticResource Caption}"
                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Style="{StaticResource IslandIconButton}" Tag="{StaticResource Aura.Glyph.Previous}"
                Command="{Binding RestartCommand}" AutomationProperties.Name="Previous" />
        <Button Command="{Binding PlayPauseCommand}" Margin="18,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
              <Setter Property="Tag" Value="{StaticResource Aura.Glyph.Pause}" />
              <Setter Property="AutomationProperties.Name" Value="Pause" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                  <Setter Property="Tag" Value="{StaticResource Aura.Glyph.Play}" />
                  <Setter Property="AutomationProperties.Name" Value="Play" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Style="{StaticResource IslandIconButton}" Tag="{StaticResource Aura.Glyph.Next}"
                Command="{Binding RestartCommand}" AutomationProperties.Name="Next" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.FakeMediaActivity">
    <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{StaticResource Aura.Blue}" Height="14"
                           BarWidth="2.5" Gap="1.5" />
  </DataTemplate>

  <!-- ===== Timer ===== -->

  <DataTemplate x:Key="Compact.FakeTimerActivity">
    <Grid>
      <controls:ProgressRing Width="18" Height="18" HorizontalAlignment="Left" Margin="11,0,0,0"
                             Progress="{Binding Progress}" RingBrush="{StaticResource Aura.Cyan}"
                             TrackBrush="{StaticResource Aura.Surface}" />
      <TextBlock Text="{Binding RemainingText}" FontSize="13" FontWeight="SemiBold"
                 Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Aura.Frost}"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Expanded.FakeTimerActivity">
    <Grid Margin="22,18,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:ProgressRing Width="44" Height="44" Thickness="4" Progress="{Binding Progress}"
                               RingBrush="{StaticResource Aura.Cyan}" TrackBrush="{StaticResource Aura.Surface}" />
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Timer" Style="{StaticResource Caption}" FontSize="12" />
          <TextBlock Text="{Binding RemainingText}" FontSize="30" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Aura.Frost}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <Button Style="{StaticResource IslandTextButton}" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" />
        <Button Style="{StaticResource IslandTextButton}" Content="+1 min" Command="{Binding AddMinuteCommand}" />
        <Button Style="{StaticResource IslandTextButton}" Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.FakeTimerActivity">
    <controls:ProgressRing Width="18" Height="18" Progress="{Binding Progress}"
                           RingBrush="{StaticResource Aura.Cyan}" TrackBrush="{StaticResource Aura.Surface}" />
  </DataTemplate>

  <!-- ===== Generic activities (engine activities without a custom view: SDK, HUDs, calls, downloads) ===== -->

  <views:GlyphKeyConverter x:Key="GlyphKey" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- Filled 16 px glyph from a resource key. -->
  <DataTemplate x:Key="GenericGlyph">
    <Viewbox Width="16" Height="16">
      <Path Width="24" Height="24" Stretch="None" Fill="{StaticResource Aura.Frost}"
            Data="{Binding LeadingGlyph, Converter={StaticResource GlyphKey}}" />
    </Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="Compact.GenericActivityView">
    <Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding LeadingText}" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                   Foreground="{StaticResource Aura.Frost}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
      </StackPanel>
      <TextBlock Text="{Binding TrailingText}" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                 Foreground="{StaticResource Aura.Frost}" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,15,0" TextTrimming="CharacterEllipsis" MaxWidth="120" />
      <controls:ProgressRing Width="18" Height="18" HorizontalAlignment="Right" Margin="0,0,13,0"
                             Progress="{Binding TrailingProgress, FallbackValue=0, TargetNullValue=0}"
                             RingBrush="{StaticResource Aura.Blue}" TrackBrush="{StaticResource Aura.Surface}"
                             Visibility="{Binding HasTrailingProgress, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Expanded.GenericActivityView">
    <StackPanel Margin="22,18,22,14">
      <StackPanel Orientation="Horizontal">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Aura.Frost}"
                   TextTrimming="CharacterEllipsis" MaxWidth="320" />
      </StackPanel>
      <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,4,0,0" Foreground="{StaticResource Aura.Mist}"
                 TextTrimming="CharacterEllipsis" />
      <ProgressBar Style="{StaticResource IslandProgressBar}" Margin="0,12,0,0"
                   Value="{Binding Progress, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"
                   Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,14,0,0"
                    Visibility="{Binding HasButtons, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource IslandTextButton}" Content="{Binding Label}" Command="{Binding Command}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="Banner.GenericActivityView">
    <Grid Margin="16,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Aura.Ring}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Aura.Mist}"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar Style="{StaticResource IslandProgressBar}" Margin="0,6,0,0"
                     Value="{Binding TrailingProgress, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"
                     Visibility="{Binding HasTrailingProgress, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.GenericActivityView">
    <Grid>
      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}" />
      <controls:ProgressRing Width="18" Height="18"
                             Progress="{Binding TrailingProgress, FallbackValue=0, TargetNullValue=0}"
                             RingBrush="{StaticResource Aura.Blue}" TrackBrush="{StaticResource Aura.Surface}"
                             Visibility="{Binding HasTrailingProgress, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DataTemplate>

  <!-- ===== Notification banner ===== -->

  <DataTemplate x:Key="Banner.FakeBannerActivity">
    <Grid Margin="16,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Aura.Ring}" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding AppName}" Style="{StaticResource Caption}" />
        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0"
                   Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Aura.Mist}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </DataTemplate>

</ResourceDictionary>
