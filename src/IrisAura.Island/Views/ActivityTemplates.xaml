<!--
  Activity templates for the Island (BLUEPRINT §8.2, §8.6). Keys are "<PresentationMode>.<ViewModelType>".
  Phase 1 renders the fake activities; Phase 2+ adds templates for engine activities.
  Brand colours come only from IrisAura.Theme (Brand.xaml); no hex values here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:IrisAura.Island.Views.Controls"
                    xmlns:views="clr-namespace:IrisAura.Island.Views"
                    xmlns:panel="clr-namespace:IrisAura.Island.Views.Panel"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

  <views:GlyphKeyConverter x:Key="GlyphKey" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <panel:ActivityTemplateSelector x:Key="NowTemplates" Prefix="Expanded" />

  <!-- Round icon button; Tag carries the glyph geometry. -->
  <Style x:Key="IslandIconButton" TargetType="Button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="18" Background="{TemplateBinding Background}"
                  BorderThickness="1.5" BorderBrush="Transparent">
            <Viewbox Width="18" Height="18">
              <Path Width="24" Height="24" Stretch="None" Fill="{TemplateBinding Foreground}"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Surface}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Indigo}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Aura.Cyan}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small pill-shaped text button. -->
  <Style x:Key="IslandTextButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
    <Setter Property="Background" Value="{StaticResource Aura.Surface}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="14" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1.5" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Indigo}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Blue}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Aura.Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin linear progress bar. -->
  <Style x:Key="IslandProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="2" Background="{StaticResource Aura.Surface}" />
            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource Aura.Frost}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Aura.Mist}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ===== Media ===== -->

  <DataTemplate x:Key="Compact.FakeMediaActivity">
    <Grid>
      <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" Margin="9,0,0,0"
              Background="{StaticResource Aura.Ring}" />
      <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{StaticResource Aura.Blue}"
                             Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Expanded.FakeMediaActivity">
    <Grid Margin="2,4,4,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource Aura.Ring}" />
        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,2,0,0"
                     Foreground="{StaticResource Aura.Mist}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock Text="{Binding AppName}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
          <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{StaticResource Aura.Blue}"
                                 Height="14" HorizontalAlignment="Right" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="38" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" Style="{StaticResource Caption}"
                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Style="{StaticResource IslandProgressBar}" Value="{Binding Progress, Mode=OneWay}"
                     VerticalAlignment="Center" Margin="4,0" AutomationProperties.Name="Playback position" />
        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Style="{StaticResource Caption}"
                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Style="{StaticResource IslandIconButton}" Tag="{StaticResource Aura.Glyph.Previous}"
                Command="{Binding RestartCommand}" AutomationProperties.Name="Previous" />
        <Button Command="{Binding PlayPauseCommand}" Margin="18,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
              <Setter Property="Tag" Value="{StaticResource Aura.Glyph.Pause}" />
              <Setter Property="AutomationProperties.Name" Value="Pause" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                  <Setter Property="Tag" Value="{StaticResource Aura.Glyph.Play}" />
                  <Setter Property="AutomationProperties.Name" Value="Play" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Style="{StaticResource IslandIconButton}" Tag="{StaticResource Aura.Glyph.Next}"
                Command="{Binding RestartCommand}" AutomationProperties.Name="Next" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.FakeMediaActivity">
    <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{StaticResource Aura.Blue}" Height="14"
                           BarWidth="2.5" Gap="1.5" />
  </DataTemplate>

  <!-- ===== Timer ===== -->

  <DataTemplate x:Key="Compact.FakeTimerActivity">
    <Grid>
      <controls:ProgressRing Width="18" Height="18" HorizontalAlignment="Left" Margin="11,0,0,0"
                             Progress="{Binding Progress}" RingBrush="{StaticResource Aura.Cyan}"
                             TrackBrush="{StaticResource Aura.Surface}" />
      <TextBlock Text="{Binding RemainingText}" FontSize="13" FontWeight="SemiBold"
                 Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Aura.Frost}"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Expanded.FakeTimerActivity">
    <Grid Margin="6,8,6,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:ProgressRing Width="44" Height="44" Thickness="4" Progress="{Binding Progress}"
                               RingBrush="{StaticResource Aura.Cyan}" TrackBrush="{StaticResource Aura.Surface}" />
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Timer" Style="{StaticResource Caption}" FontSize="12" />
          <TextBlock Text="{Binding RemainingText}" FontSize="30" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Aura.Frost}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <Button Style="{StaticResource IslandTextButton}" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" />
        <Button Style="{StaticResource IslandTextButton}" Content="+1 min" Command="{Binding AddMinuteCommand}" />
        <Button Style="{StaticResource IslandTextButton}" Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.FakeTimerActivity">
    <controls:ProgressRing Width="18" Height="18" Progress="{Binding Progress}"
                           RingBrush="{StaticResource Aura.Cyan}" TrackBrush="{StaticResource Aura.Surface}" />
  </DataTemplate>

  <!-- ===== Real media (BLUEPRINT §8.6.1–§8.6.2) ===== -->

  <!-- Album art with rounded corners, or the app icon directly on the black pill (no background colour —
       owner request 2026-11-25). Size comes from the parent; Tag carries the corner radius.
       CacheMode=BitmapCache: the images are rasterised once instead of re-scaled on every 30 Hz waveform frame
       (measured: the waveform redraw cost ~5 % CPU with uncached images, ADR 0006). -->
  <DataTemplate x:Key="MediaArt">
    <Grid CacheMode="BitmapCache">
      <Image Source="{Binding AppIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Style>
          <Style TargetType="Image">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasAlbumArt}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Image.Style>
      </Image>
      <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}, FallbackValue=6}"
              Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVisibility}}">
        <Border.Background>
          <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Compact.MediaActivityView">
    <Grid>
      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MediaArt}" Tag="6"
                        Width="22" Height="22" HorizontalAlignment="Left" Margin="9,0,0,0" />
      <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{Binding AccentBrush}"
                             Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
    </Grid>
  </DataTemplate>

  <!-- Media card in the panel's now slot (Phase 4B, §8.13A): large art with the app badge, title / artist, live
       waveform, seekable progress, transport controls. -->
  <DataTemplate x:Key="Expanded.MediaActivityView">
    <Grid Margin="2,0,4,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Command="{Binding OpenAppCommand}" Cursor="Hand" Focusable="True"
                AutomationProperties.Name="{Binding AppName, StringFormat=Open {0}}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MediaArt}" Tag="16" />
            </ControlTemplate>
          </Button.Template>
        </Button>
        <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
          <Button Command="{Binding OpenAppCommand}" Cursor="Hand" HorizontalAlignment="Left"
                  AutomationProperties.Name="{Binding AppName, StringFormat=Open {0}}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                  <Image Source="{Binding AppIcon}" Width="13" Height="13" Margin="0,0,5,0"
                         RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache" />
                  <TextBlock Text="{Binding AppName}" Style="{StaticResource Caption}" MaxWidth="150" />
                </StackPanel>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"
                     Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
          <Grid Margin="0,2,0,0">
            <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,0,40,0"
                       Foreground="{StaticResource Aura.Mist}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasArtist, Converter={StaticResource BoolToVisibility}}" />
            <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{Binding AccentBrush}"
                                   Height="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Others}" Margin="0,3,0,0"
                        Visibility="{Binding HasOthers, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding Select}" Cursor="Hand" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding Name, StringFormat=Switch to {0}}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <TextBlock Text="{Binding Name, StringFormat=Also: {0}}" FontSize="11"
                                 Foreground="{StaticResource Aura.Cyan}" TextDecorations="Underline" />
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="0,6,0,2" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" Style="{StaticResource Caption}"
                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
        <controls:SeekBar Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                          Progress="{Binding Progress}" CanSeek="{Binding CanSeek}" SeekCommand="{Binding SeekCommand}"
                          TrackBrush="{StaticResource Aura.Surface}" FillBrush="{StaticResource Aura.Frost}"
                          AutomationProperties.Name="Playback position" />
        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Style="{StaticResource Caption}"
                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Style="{StaticResource IslandIconButton}" Tag="{StaticResource Aura.Glyph.Previous}"
                Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" AutomationProperties.Name="Previous" />
        <Button Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanPlayPause}" Margin="18,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
              <Setter Property="Tag" Value="{StaticResource Aura.Glyph.Pause}" />
              <Setter Property="AutomationProperties.Name" Value="Pause" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                  <Setter Property="Tag" Value="{StaticResource Aura.Glyph.Play}" />
                  <Setter Property="AutomationProperties.Name" Value="Play" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Style="{StaticResource IslandIconButton}" Tag="{StaticResource Aura.Glyph.Next}"
                Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" AutomationProperties.Name="Next" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.MediaActivityView">
    <controls:WaveformBars Levels="{Binding Bars}" BarBrush="{Binding AccentBrush}" Height="14"
                           BarWidth="2.5" Gap="1.5" />
  </DataTemplate>

  <!-- ===== Generic activities (engine activities without a custom view: SDK, HUDs, calls, downloads) ===== -->

  <!-- Filled 16 px glyph from a resource key. -->
  <!-- Tone (brand tokens only, BLUEPRINT §0.4): Success = Aura.Cyan (charging, connected, done), Alert = Aura.Error
       (low battery, timer finished). -->
  <DataTemplate x:Key="GenericGlyph">
    <Grid>
      <Viewbox Width="16" Height="16" Visibility="{Binding HasLeadingImage, Converter={StaticResource InverseBoolToVisibility}}">
        <Path x:Name="Glyph" Width="24" Height="24" Stretch="None" Fill="{StaticResource Aura.Frost}"
              Data="{Binding LeadingGlyph, Converter={StaticResource GlyphKey}}" />
      </Viewbox>
      <!-- An SDK app's own icon (§8.6.14), rounded, cached as a bitmap. -->
      <Border Width="18" Height="18" CornerRadius="4" CacheMode="BitmapCache"
              Visibility="{Binding HasLeadingImage, Converter={StaticResource BoolToVisibility}}">
        <Border.Background>
          <ImageBrush ImageSource="{Binding LeadingImage}" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Success">
        <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource Aura.Cyan}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Alert">
        <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource Aura.Error}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="Compact.GenericActivityView">
    <Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding LeadingText}" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                   Foreground="{StaticResource Aura.Frost}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
      </StackPanel>
      <TextBlock Text="{Binding TrailingText}" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                 Foreground="{StaticResource Aura.Frost}" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,15,0" TextTrimming="CharacterEllipsis" MaxWidth="120" />
      <controls:ProgressRing Width="18" Height="18" HorizontalAlignment="Right" Margin="0,0,13,0"
                             Progress="{Binding TrailingProgress, FallbackValue=0, TargetNullValue=0}"
                             RingBrush="{StaticResource Aura.Blue}" TrackBrush="{StaticResource Aura.Surface}"
                             Visibility="{Binding HasTrailingProgress, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Expanded.GenericActivityView">
    <StackPanel Margin="6,10,6,6">
      <StackPanel Orientation="Horizontal">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Aura.Frost}"
                   TextTrimming="CharacterEllipsis" MaxWidth="290" />
      </StackPanel>
      <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,4,0,0" Foreground="{StaticResource Aura.Mist}"
                 TextTrimming="CharacterEllipsis" />
      <ProgressBar Style="{StaticResource IslandProgressBar}" Margin="0,12,0,0"
                   Value="{Binding Progress, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"
                   Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,14,0,0"
                    Visibility="{Binding HasButtons, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource IslandTextButton}" Content="{Binding Label}" Command="{Binding Command}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="Banner.GenericActivityView">
    <Grid Margin="16,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="IconBox" Width="40" Height="40" CornerRadius="10" Background="{StaticResource Aura.Ring}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Aura.Mist}"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar Style="{StaticResource IslandProgressBar}" Margin="0,6,0,0"
                     Value="{Binding TrailingProgress, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"
                     Visibility="{Binding HasTrailingProgress, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <!-- A coloured glyph sits on the dark surface; the Aura ring is kept for neutral banners. -->
      <DataTrigger Binding="{Binding Tone}" Value="Success">
        <Setter TargetName="IconBox" Property="Background" Value="{StaticResource Aura.Surface}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Alert">
        <Setter TargetName="IconBox" Property="Background" Value="{StaticResource Aura.Surface}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.GenericActivityView">
    <Grid>
      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GenericGlyph}" />
      <controls:ProgressRing Width="18" Height="18"
                             Progress="{Binding TrailingProgress, FallbackValue=0, TargetNullValue=0}"
                             RingBrush="{StaticResource Aura.Blue}" TrackBrush="{StaticResource Aura.Surface}"
                             Visibility="{Binding HasTrailingProgress, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DataTemplate>

  <!-- ===== Island timer (BLUEPRINT §8.6.10) ===== -->

  <DataTemplate x:Key="Compact.TimerActivityView">
    <Grid>
      <controls:ProgressRing Width="18" Height="18" HorizontalAlignment="Left" Margin="11,0,0,0"
                             Progress="{Binding Progress}" RingBrush="{StaticResource Aura.Cyan}"
                             TrackBrush="{StaticResource Aura.Surface}" />
      <TextBlock Text="{Binding RemainingText}" FontSize="13" FontWeight="SemiBold"
                 Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Aura.Frost}"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Expanded.TimerActivityView">
    <Grid Margin="6,8,6,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:ProgressRing Width="44" Height="44" Thickness="4" Progress="{Binding Progress}"
                               RingBrush="{StaticResource Aura.Cyan}" TrackBrush="{StaticResource Aura.Surface}" />
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" FontSize="12" />
          <TextBlock Text="{Binding RemainingText}" FontSize="30" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Aura.Frost}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <Button Style="{StaticResource IslandTextButton}" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" />
        <Button Style="{StaticResource IslandTextButton}" Content="+1 min" Command="{Binding AddMinuteCommand}" />
        <Button Style="{StaticResource IslandTextButton}" Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Bubble.TimerActivityView">
    <controls:ProgressRing Width="18" Height="18" Progress="{Binding Progress}"
                           RingBrush="{StaticResource Aura.Cyan}" TrackBrush="{StaticResource Aura.Surface}" />
  </DataTemplate>

  <!-- ===== Dashboard panel (Phase 4B, BLUEPRINT §8.13A) ===== -->

  <!-- Tab button: Tag = selected. -->
  <Style x:Key="PanelTabButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Aura.Mist}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="13" Padding="14,4" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value>
                <system:Boolean>True</system:Boolean>
              </Trigger.Value>
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Aura.Surface}" />
              <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Aura.Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SmallTextButton" TargetType="Button" BasedOn="{StaticResource IslandTextButton}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style x:Key="PanelCard" TargetType="Border">
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{StaticResource Aura.Surface}" />
  </Style>

  <DataTemplate x:Key="Expanded.DashboardView">
    <Grid Margin="20,12,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="28" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Tabs -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource PanelTabButton}" Content="Island" Tag="{Binding IsIslandTab}"
                Command="{Binding ShowIslandCommand}" AutomationProperties.Name="Island tab" />
        <Button Style="{StaticResource PanelTabButton}" Content="{Binding TrayTabText}" Tag="{Binding IsTrayTab}"
                Command="{Binding ShowTrayCommand}" Margin="4,0,0,0" AutomationProperties.Name="Tray tab" />
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Clear tray"
              Command="{Binding Shelf.ClearCommand}" AutomationProperties.Name="Clear the file tray">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SmallTextButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsTrayTab}" Value="True" />
                  <Condition Binding="{Binding Shelf.HasItems}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>

      <!-- Island tab: now card, calendar strip, camera mirror -->
      <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsIslandTab, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="148" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="104" />
        </Grid.ColumnDefinitions>

        <ContentPresenter Grid.Column="0" Content="{Binding Now}" ContentTemplateSelector="{StaticResource NowTemplates}" />
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0"
                    Visibility="{Binding HasNow, Converter={StaticResource InverseBoolToVisibility}}">
          <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
            <Path Width="24" Height="24" Stretch="None" Fill="{StaticResource Aura.Mist}" Data="{StaticResource Aura.Glyph.Play}" />
          </Viewbox>
          <TextBlock Text="Nothing playing" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                     Foreground="{StaticResource Aura.Frost}" />
          <TextBlock Text="Music, timers, calls and downloads show up here." Style="{StaticResource Caption}"
                     TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Calendar strip: dates only (no calendar access) -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12,10,12,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Calendar.Month}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Aura.Frost}" />
              <TextBlock Text="{Binding Calendar.Year}" Style="{StaticResource Caption}" Margin="6,0,0,1" VerticalAlignment="Bottom" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Calendar.Days}" Margin="0,10,0,0" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Center" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Initial}" FontSize="10" Foreground="{StaticResource Aura.Mist}" HorizontalAlignment="Center" />
                    <Grid Width="23" Height="23" Margin="0,4,0,0">
                      <Ellipse Fill="{StaticResource Aura.Blue}"
                               Visibility="{Binding IsToday, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Aura.Frost}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No calendar connected" Style="{StaticResource Caption}" FontSize="10.5" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <!-- Camera mirror: opt-in; the camera runs only while this shows -->
        <Border Grid.Column="4" Style="{StaticResource PanelCard}" Padding="8,10,8,8" DataContext="{Binding Mirror}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Width="72" Height="72" HorizontalAlignment="Center">
              <Ellipse Fill="{StaticResource Aura.Void}" />
              <Viewbox Width="22" Height="22" Visibility="{Binding IsLive, Converter={StaticResource InverseBoolToVisibility}}">
                <Path Width="24" Height="24" Stretch="None" Fill="{StaticResource Aura.Mist}" Data="{StaticResource Aura.Glyph.Camera}" />
              </Viewbox>
              <Ellipse Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.Name="Camera mirror (live, not recorded)">
                <Ellipse.Fill>
                  <ImageBrush ImageSource="{Binding Frame}" Stretch="UniformToFill">
                    <ImageBrush.RelativeTransform>
                      <ScaleTransform ScaleX="-1" CenterX="0.5" />
                    </ImageBrush.RelativeTransform>
                  </ImageBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="10" Foreground="{StaticResource Aura.Mist}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
            <Button Grid.Row="2" Style="{StaticResource SmallTextButton}" HorizontalAlignment="Center"
                    Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                    AutomationProperties.Name="{Binding ToggleText, StringFormat={}{0} camera mirror}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Tray tab: file shortcuts -->
      <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsTrayTab, Converter={StaticResource BoolToVisibility}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Shelf.HasItems, Converter={StaticResource InverseBoolToVisibility}}">
          <Viewbox Width="24" Height="24">
            <Path Width="24" Height="24" Stretch="None" Fill="{StaticResource Aura.Mist}" Data="{StaticResource Aura.Glyph.Download}" />
          </Viewbox>
          <TextBlock Text="Drop files on the Island to keep them here" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource Aura.Frost}" Margin="0,10,0,0" HorizontalAlignment="Center" />
          <TextBlock Text="Shortcuts only: your files stay where they are. Drag them out to any app."
                     Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding Shelf.HasItems, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Shelf.Items}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Width="84" Height="78" Margin="0,0,2,2">
                  <Border x:Name="Tile" CornerRadius="14" Background="Transparent" Cursor="Hand"
                          panel:ShelfDrag.IsSource="True" ToolTip="{Binding Name}"
                          AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                    <StackPanel Margin="4,8,4,4">
                      <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache" />
                      <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource Aura.Frost}" Margin="0,5,0,0"
                                 TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" />
                    </StackPanel>
                  </Border>
                  <Button x:Name="Remove" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                          Command="{Binding RemoveCommand}" Visibility="Hidden" Cursor="Hand"
                          AutomationProperties.Name="{Binding Name, StringFormat=Remove {0} from the tray}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border CornerRadius="9" Background="{StaticResource Aura.Surface}" BorderBrush="{StaticResource Aura.Mist}" BorderThickness="1">
                          <Path Data="M 0,0 L 6,6 M 6,0 L 0,6" Stroke="{StaticResource Aura.Frost}" StrokeThickness="1.4"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource Aura.Surface}" />
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                  </Trigger>
                  <Trigger SourceName="Remove" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource Aura.Surface}" />
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DataTemplate>

  <!-- ===== Device connected (Phase 4B design): device glyph in a ring that fills to the battery level ===== -->

  <DataTemplate x:Key="Banner.DeviceActivityView">
    <Grid Margin="14,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <ScaleTransform x:Name="Pop" ScaleX="0.6" ScaleY="0.6" />
        </Grid.RenderTransform>
        <Ellipse Fill="{StaticResource Aura.Surface}" />
        <controls:ProgressRing x:Name="Battery" Width="48" Height="48" Thickness="3" Progress="{Binding BatteryFraction}"
                               RingBrush="{StaticResource Aura.Cyan}" TrackBrush="{StaticResource Aura.Surface}" />
        <Viewbox Width="22" Height="22">
          <Path Width="24" Height="24" Stretch="None" Fill="{StaticResource Aura.Frost}"
                Data="{Binding Glyph, Converter={StaticResource GlyphKey}}" />
        </Viewbox>
        <Grid.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.35">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.35">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
      </Grid>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Aura.Mist}" />
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <!-- Battery unknown: a faint full ring instead of a level. -->
      <DataTrigger Binding="{Binding HasBattery}" Value="False">
        <Setter TargetName="Battery" Property="Opacity" Value="0.35" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===== Notification banner ===== -->

  <DataTemplate x:Key="Banner.FakeBannerActivity">
    <Grid Margin="16,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Aura.Ring}" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding AppName}" Style="{StaticResource Caption}" />
        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0"
                   Foreground="{StaticResource Aura.Frost}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Aura.Mist}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </DataTemplate>

</ResourceDictionary>
