<!-- Debug panel (BLUEPRINT §10 Phases 1–2): drives the activity engine with fake activities and shows
     the arbiter's layout, provider states and live performance. A normal window; the Island itself
     never activates. -->
<Window x:Class="IrisAura.Island.Diagnostics.DebugPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IrisAura Island — debug panel"
        Width="500" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Background="{StaticResource Aura.Surface}"
        Foreground="{StaticResource Aura.Frost}"
        FontFamily="{StaticResource Aura.Font.UI}"
        FontSize="12.5">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
      <Setter Property="Background" Value="{StaticResource Aura.Void}" />
      <Setter Property="BorderBrush" Value="{StaticResource Aura.Indigo}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Aura.Frost}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Aura.Mist}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,6" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="16">
    <TextBlock Text="IrisAura Island — activity engine" FontSize="16" FontWeight="SemiBold" />
    <Border Height="2" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0" Background="{StaticResource Aura.Ring}" />

    <TextBlock Text="Persistent activities (priority)" Style="{StaticResource Heading}" />
    <WrapPanel>
      <Button Content="Media (50)" Click="OnMedia" />
      <Button Content="Play / pause media" Click="OnPlayPause" />
      <Button Content="Timer 5 min (60)" Click="OnTimer" />
      <Button Content="Timer 12 s (→85)" Click="OnShortTimer" />
      <Button Content="Call (90)" Click="OnCall" />
      <Button Content="Download (40)" Click="OnDownload" />
      <Button Content="SDK-style custom (35)" Click="OnCustom" />
      <Button Content="End all" Click="OnEndAll" />
    </WrapPanel>

    <TextBlock Text="Transient activities" Style="{StaticResource Heading}" />
    <WrapPanel>
      <Button Content="Notification (80, 4 s)" Click="OnBanner" />
      <Button Content="Volume +" Click="OnVolumeUp" />
      <Button Content="Volume −" Click="OnVolumeDown" />
      <Button Content="Charging (70, 2.5 s)" Click="OnCharging" />
    </WrapPanel>

    <TextBlock Text="Interaction" Style="{StaticResource Heading}" />
    <WrapPanel>
      <Button Content="Swap pill / bubble" Click="OnSwap" />
      <Button Content="Cycle ▶" Click="OnCycle" />
      <Button Content="Pin / unpin expanded" Click="OnPin" />
      <Button Content="Shake" Click="OnShake" />
      <Button Content="Hide 1 hour" Click="OnHide" />
      <Button Content="Show" Click="OnShow" />
    </WrapPanel>
    <TextBlock x:Name="HotkeyText" Foreground="{StaticResource Aura.Mist}" TextWrapping="Wrap" />

    <TextBlock Text="Provider isolation" Style="{StaticResource Heading}" />
    <WrapPanel>
      <Button Content="Simulate provider failure" Click="OnFail" BorderBrush="{StaticResource Aura.Error}" />
      <Button Content="Restart debug provider" Click="OnRestart" />
    </WrapPanel>

    <TextBlock Text="Options" Style="{StaticResource Heading}" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="Reduced motion:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="ReducedMotionBox" Width="160" SelectionChanged="OnReducedMotionChanged">
        <ComboBoxItem Content="Follow Windows" />
        <ComboBoxItem Content="On" />
        <ComboBoxItem Content="Off" />
      </ComboBox>
    </StackPanel>
    <CheckBox x:Name="QuietBox" Content="Quiet mode (suppress notification banners)" Click="OnQuietChanged" />
    <CheckBox x:Name="FollowCursorBox" Content="Follow the cursor's monitor" Click="OnOptionChanged" />
    <CheckBox x:Name="ShowOverFullscreenBox" Content="Show over full-screen apps" Click="OnOptionChanged" />

    <TextBlock Text="Status" Style="{StaticResource Heading}" />
    <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
               Foreground="{StaticResource Aura.Frost}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Quit IrisAura Island" Click="OnQuit" BorderBrush="{StaticResource Aura.Error}" />
    </StackPanel>
  </StackPanel>
</Window>
