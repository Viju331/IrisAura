# Normalise line endings in the repository; check out with the platform default.
* text=auto

# Windows-only formats that tools expect with CRLF
*.sln       text eol=crlf
*.slnf      text eol=crlf
*.vcxproj   text eol=crlf
*.filters   text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.def       text eol=crlf
*.rc        text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.ico  binary
*.bmp  binary
*.onnx binary
*.dll  binary
*.exe  binary
*.msi  binary
*.msix binary
